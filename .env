# Django environment configuration
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary configuration
# Note: current settings.py checks CLOUDINARY_CLOUD_NAME and then reads the values from
# env variables named dt2xmstnz, 596239937122474, and gwuTlo-e9czIhr4neiTFtKRYgiU.
CLOUDINARY_CLOUD_NAME=dt2xmstnz
# The following names are used as-is in the current settings.py implementation:
dt2xmstnz=dt2xmstnz
596239937122474=596239937122474
gwuTlo-e9czIhr4neiTFtKRYgiU=gwuTlo-e9czIhr4neiTFtKRYgiU

# CSRF and cookie security settings
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
